{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/handler.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.venv/**,data/**,dist/**,tests/**,voice_api/test_*.py}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler"
    },
    {
      "source": "/health",
      "destination": "/api/handler"
    }
  ],
  "installCommand": "npm ci",
  "regions": [
    "sin1"
  ]
}
